{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-backend-469575199115.asia-south1.run.app/api/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://api-backend-469575199115.asia-south1.run.app/v1/:path*"
    },
    { "source": "/", "destination": "/backend/static/dashboard.html" },
    { "source": "/checkout", "destination": "/backend/static/checkout.html" },
    { "source": "/downloads", "destination": "/backend/static/downloads.html" },
    { "source": "/hall-of-frauds", "destination": "/backend/static/hall_of_frauds.html" },
    { "source": "/privacy-policy", "destination": "/backend/static/privacy-policy.html" },
    { "source": "/terms", "destination": "/backend/static/terms.html" },
    { "source": "/refund-policy", "destination": "/backend/static/refund-policy.html" },
    { "source": "/roadmap", "destination": "/backend/static/roadmap.html" },
    { "source": "/static/releases.json", "destination": "/backend/static/releases.json" }
  ]
}