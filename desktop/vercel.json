{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-GCP-BACKEND-URL.a.run.app/api/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://YOUR-GCP-BACKEND-URL.a.run.app/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
