# ============================================================
# Shackle AI — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to version control.
# ============================================================

# ----------------------------------------------------------
# Google OAuth (Desktop loopback flow)
# ----------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
LOOPBACK_REDIRECT_URI=http://0.0.0.0:8080/v1/auth/callback

# ----------------------------------------------------------
# ElevenLabs (Premium voice cloning / TTS)
# ----------------------------------------------------------
ELEVENLABS_API_KEY=

# ----------------------------------------------------------
# Razorpay (Billing & payments)
# ----------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ----------------------------------------------------------
# Firebase (Service account credentials)
# Either place the JSON file at config/firebase-service-account.json
# OR paste the entire JSON as a single-line string here.
# ----------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_RAW=

# ----------------------------------------------------------
# Gemini AI (Roast generation / autonomous audit agent)
# ----------------------------------------------------------
GEMINI_API_KEY=

# ----------------------------------------------------------
# Vite / Frontend (handled automatically by Vite at build time;
# listed here for documentation purposes only)
# ----------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DB_ID=
VITE_FIREBASE_MEASUREMENT_ID=